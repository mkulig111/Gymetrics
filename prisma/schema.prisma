// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExerciseType {
  WEIGHT_REPS
  BODYWEIGHT_REPS
  TIME
}

enum SetType {
  WORK
  WARMUP
  DROP
  FAILURE
}

model Exercise {
  id        String       @id @default(cuid())
  name      String
  type      ExerciseType @default(WEIGHT_REPS)
  isCustom  Boolean      @default(false)
  createdAt DateTime     @default(now())

  routineExercises RoutineExercise[]
  workoutExercises WorkoutExercise[]
  bodyParts        ExerciseBodyPart[]
}

model BodyPart {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  exercises ExerciseBodyPart[]
}

model ExerciseBodyPart {
  id         String   @id @default(cuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  bodyPartId String
  bodyPart   BodyPart @relation(fields: [bodyPartId], references: [id], onDelete: Cascade)
  percentage Float    @default(100)

  @@unique([exerciseId, bodyPartId])
}

model Routine {
  id                  String   @id @default(cuid())
  name                String
  notes               String?
  order               Int      @default(0)
  archived            Boolean  @default(false)
  label               String   @default("")
  deloadInterval      Int      @default(6)
  workoutsSinceDeload Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  exercises RoutineExercise[]
  sessions  WorkoutSession[]
}

model RoutineExercise {
  id         String   @id @default(cuid())
  routineId  String
  routine    Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  order      Int
  notes      String?

  sets RoutineSet[]
}

model RoutineSet {
  id                String          @id @default(cuid())
  routineExerciseId String
  routineExercise   RoutineExercise @relation(fields: [routineExerciseId], references: [id], onDelete: Cascade)
  setIndex          Int
  targetReps        Int?
  targetWeightKg     Float?
  targetSeconds      Int?
}

model WorkoutSession {
  id          String    @id @default(cuid())
  routineId   String?
  routine     Routine?  @relation(fields: [routineId], references: [id])
  routineName String
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  notes       String?

  exercises WorkoutExercise[]
}

model WorkoutExercise {
  id         String         @id @default(cuid())
  sessionId  String
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise       @relation(fields: [exerciseId], references: [id])
  order      Int

  sets WorkoutSet[]
}

model WorkoutSet {
  id                String          @id @default(cuid())
  workoutExerciseId String
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  setIndex          Int
  type              SetType         @default(WORK)
  weightKg          Float?
  reps              Int?
  seconds           Int?
  completed         Boolean         @default(false)
  isPr              Boolean         @default(false)
}

enum SetCategory {
  MAIN
  DROP_OFF
  OTHER
}

enum ProgrammeTemplate {
  CUSTOM
  BBB
  TRIUMVIRATE
  FSL
}

enum MainLift {
  SQUAT
  BENCH
  DEADLIFT
  PRESS
}

enum ProgressionCondition {
  AUTO
  AMRAP_THRESHOLD
}

model Programme {
  id                   String               @id @default(cuid())
  name                 String
  notes                String?
  archived             Boolean              @default(false)
  currentWeek          Int                  @default(1)
  currentCycle         Int                  @default(1)
  templateType         ProgrammeTemplate    @default(CUSTOM)

  // Training 1RMs (kg) — used for structured templates
  tmSquat              Float?
  tmBench              Float?
  tmDeadlift           Float?
  tmPress              Float?
  tmPercentage         Float                @default(90)
  roundingIncrement    Float                @default(2.5)
  cycleLengthWeeks     Int                  @default(4)
  hasDeloadWeek        Boolean              @default(false)

  // Per-cycle progression
  progressionUpper     Float                @default(2.5)
  progressionLower     Float                @default(5.0)
  progressionCondition ProgressionCondition @default(AUTO)
  amrapThreshold       Int                  @default(5)

  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  weeks       ProgrammeWeek[]
  days        ProgrammeDay[]
  weekSchemes ProgrammeWeekScheme[]
}

model ProgrammeWeek {
  id          String    @id @default(cuid())
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  weekNumber  Int
  label       String?

  schemes ProgrammeSetScheme[]

  @@unique([programmeId, weekNumber])
}

model ProgrammeSetScheme {
  id       String        @id @default(cuid())
  weekId   String
  week     ProgrammeWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  category SetCategory
  sets     Int           @default(3)
  reps     Int           @default(5)

  @@unique([weekId, category])
}

model ProgrammeDay {
  id                 String      @id @default(cuid())
  programmeId        String
  programme          Programme   @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  dayOfWeek          Int
  mainLift           MainLift
  assistanceCategory SetCategory

  @@unique([programmeId, dayOfWeek])
}

model ProgrammeWeekScheme {
  id          String                  @id @default(cuid())
  programmeId String
  programme   Programme               @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  weekNum     Int
  entries     ProgrammeSetSchemeEntry[]

  @@unique([programmeId, weekNum])
}

model ProgrammeSetSchemeEntry {
  id           String              @id @default(cuid())
  weekSchemeId String
  weekScheme   ProgrammeWeekScheme @relation(fields: [weekSchemeId], references: [id], onDelete: Cascade)
  percent      Float
  reps         Int
  isAmrap      Boolean             @default(false)
  setOrder     Int
}

model BodyweightEntry {
  id       String   @id @default(cuid())
  date     DateTime @default(now())
  weightKg Float
}

model ProgressPhoto {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  imageData String
}

model GripStrengthEntry {
  id   String   @id @default(cuid())
  date DateTime @default(now())
  kg   Float
}

model HrvEntry {
  id     String   @id @default(cuid())
  date   DateTime @default(now())
  rmssd  Float
}

model WellnessEntry {
  id    String   @id @default(cuid())
  date  DateTime @default(now())
  score Float
}
